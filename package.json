{
  "name": "@dustwave/scheduler",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --port 8787",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "types": "wrangler types",
    "test": "vitest run",
    "check": "node scripts/jev-evaluation.mjs --check",
    "template:check": "node shared/dust-wave-jekyll-template/bin/sync-consumer.mjs --consumer-root . --check",
    "deploy": "npm run check && wrangler deploy",
    "test:browser": "node web/tests/browser.mjs",
    "format": "prettier --write worker/src web scripts *.json *.jsonc *.ts .github/workflows",
    "setup": "node scripts/setup.mjs",
    "test:quality": "node scripts/audit-quality.mjs",
    "test:setup": "node scripts/test-setup.mjs",
    "benchmark:availability": "node scripts/benchmark-availability.mjs",
    "clean": "node scripts/clean.mjs",
    "audit:dependencies": "npm audit --audit-level=moderate && node scripts/audit-ruby.mjs",
    "test:audit": "node --test scripts/audit-ruby.test.mjs scripts/credential-signatures.test.mjs",
    "test:platform": "node --test scripts/platform-pin.test.mjs",
    "check:offline": "npm run template:check && npm run typecheck && npm run test:audit && npm run test:platform && npm run test:jev:unit && npm test && npm run build && npm run test:quality && npm run test:setup && npm run test:browser && wrangler deploy --dry-run",
    "test:jev": "node scripts/jev-evaluation.mjs",
    "test:jev:unit": "node --test scripts/jev-evaluation.test.mjs"
  },
  "dependencies": {
    "@dustwave/admin-shell": "file:shared/dust-wave-platform/packages/admin-shell",
    "@dustwave/media-core": "file:shared/dust-wave-platform/packages/media-core",
    "@dustwave/site-shell": "file:shared/dust-wave-platform/packages/site-shell",
    "@dustwave/worker-core": "file:shared/dust-wave-platform/packages/worker-core",
    "@js-temporal/polyfill": "0.5.1",
    "ical.js": "2.2.1",
    "sax": "1.6.1",
    "tsdav": "2.3.3",
    "xml-js": "1.6.11",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/sax": "1.2.7",
    "acorn": "8.18.0",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.8",
    "sass": "1.104.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.136.0",
    "sharp": "0.35.4",
    "@dustwave/test-core": "file:shared/dust-wave-platform/packages/test-core"
  },
  "overrides": {
    "sharp": "$sharp",
    "workerd": "1.20260908.1"
  }
}
